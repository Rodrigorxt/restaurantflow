{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(http_server_request_duration_seconds_count[5m])) by (service_name)", "legendFormat": "{{service_name}}", "refId": "A" }
      ],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, service_name))", "legendFormat": "{{service_name}}", "refId": "A" }
      ],
      "title": "HTTP p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        { "expr": "{service_name=~\"restaurantflow-.+\"}", "refId": "A" }
      ],
      "title": "Service logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 42,
  "tags": ["restaurantflow", "microservices"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "RestaurantFlow Overview",
  "uid": "restaurantflow-overview",
  "version": 1
}
