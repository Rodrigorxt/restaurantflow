@host = http://localhost:8080
@identity = http://localhost:8081
@customerId = 2d42a448-d6ea-4577-9b76-98f38682b820

### Obtain an administrator token
# @name adminLogin
POST {{identity}}/realms/restaurantflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=restaurantflow-cli&username=restaurant-admin&password=admin

### Obtain a customer token
# @name customerLogin
POST {{identity}}/realms/restaurantflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=restaurantflow-cli&username=customer&password=customer

### Obtain a kitchen operator token
# @name kitchenLogin
POST {{identity}}/realms/restaurantflow/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=restaurantflow-cli&username=kitchen&password=kitchen

### Check the gateway
GET {{host}}/health

### Create a menu item
# @name createMenuItem
POST {{host}}/api/menu/items
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.access_token}}

{
  "name": "Truffle Burger",
  "description": "Beef, truffle sauce and aged cheese",
  "category": "Main",
  "price": 29.90
}

### List available menu items
GET {{host}}/api/menu/items

### Create an approved order
# @name createApprovedOrder
POST {{host}}/api/orders
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

{
  "customerId": "{{customerId}}",
  "customerEmail": "customer@example.com",
  "paymentReference": "demo-approved",
  "items": [
    {
      "menuItemId": "{{createMenuItem.response.body.$.id}}",
      "quantity": 2
    }
  ]
}

### Read the approved order after asynchronous processing
GET {{host}}/api/orders/{{createApprovedOrder.response.body.$.id}}
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

### Inspect the approved order workflow saga
GET {{host}}/api/orders/{{createApprovedOrder.response.body.$.id}}/workflow
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

### Simulate a declined payment
# @name createDeclinedOrder
POST {{host}}/api/orders
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

{
  "customerId": "{{customerId}}",
  "customerEmail": "customer@example.com",
  "paymentReference": "decline-demo",
  "items": [
    {
      "menuItemId": "{{createMenuItem.response.body.$.id}}",
      "quantity": 1
    }
  ]
}

### Read the declined order after asynchronous processing
GET {{host}}/api/orders/{{createDeclinedOrder.response.body.$.id}}
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

### Inspect the compensated workflow saga
GET {{host}}/api/orders/{{createDeclinedOrder.response.body.$.id}}/workflow
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

### List kitchen tickets
GET {{host}}/api/kitchen/tickets
Authorization: Bearer {{kitchenLogin.response.body.$.access_token}}
