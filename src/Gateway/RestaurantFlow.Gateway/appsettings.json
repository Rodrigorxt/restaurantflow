{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "menu-read": {
        "ClusterId": "menu",
        "Match": { "Path": "/api/menu/{**catch-all}", "Methods": [ "GET" ] }
      },
      "menu-admin": {
        "ClusterId": "menu",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/menu/{**catch-all}", "Methods": [ "POST", "PATCH", "PUT", "DELETE" ] }
      },
      "orders": {
        "ClusterId": "orders",
        "AuthorizationPolicy": "customer",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "kitchen": {
        "ClusterId": "kitchen",
        "AuthorizationPolicy": "kitchen",
        "Match": { "Path": "/api/kitchen/{**catch-all}" }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "admin",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "menu": { "Destinations": { "primary": { "Address": "http://menu-api:8080" } } },
      "orders": { "Destinations": { "primary": { "Address": "http://orders-api:8080" } } },
      "kitchen": { "Destinations": { "primary": { "Address": "http://kitchen-api:8080" } } },
      "payments": { "Destinations": { "primary": { "Address": "http://payments-api:8080" } } }
    }
  },
  "AllowedHosts": "*"
}
